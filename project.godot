; Engine configuration file.
; Godot 4.7 이상에서 열어주세요.

config_version=5

[application]

config/name="용병의 대륙"
run/main_scene="res://ui/title/title_screen.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ContinentOfMercenaries"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

RNG="*res://core/rng.gd"
EventBus="*res://core/event_bus.gd"
DataDB="*res://core/data_db.gd"
AssetRegistry="*res://core/asset_registry.gd"
GameState="*res://core/game_state.gd"
TimeManager="*res://core/time_manager.gd"
SaveManager="*res://core/save_manager.gd"
Settings="*res://core/settings.gd"
DevScreenshot="*res://tools/screenshot.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.ko.translation")
locale/fallback="ko"

[rendering]

environment/defaults/default_clear_color=Color(0.12, 0.11, 0.1, 1)

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
